{
  "name": "estrutura-prototipo",
  "version": "0.2.0",
  "private": true,
  "description": "Protótipo independente de análise elástica de vigas biapoiadas",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "python3 -m backend.server",
