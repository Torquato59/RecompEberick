    "validate": "python3 scripts/validate_calculations.py",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
